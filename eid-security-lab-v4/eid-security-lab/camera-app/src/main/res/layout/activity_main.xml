<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080812"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingTop="52dp"
      android:paddingBottom="48dp"
      android:paddingLeft="32dp"
      android:paddingRight="32dp">

    <!-- Lanterns -->
    <LinearLayout
        android:id="@+id/lantern_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="🪔" android:textSize="30sp" android:layout_marginEnd="18dp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="🕌" android:textSize="34sp" android:layout_marginEnd="18dp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="🪔" android:textSize="30sp"/>
    </LinearLayout>

    <!-- Moon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌙"
        android:textSize="80sp"
        android:layout_marginBottom="8dp"/>

    <!-- Arabic greeting -->
    <TextView
        android:id="@+id/txt_arabic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="عيد مبارك"
        android:textSize="44sp"
        android:textColor="#F0D080"
        android:fontFamily="serif"
        android:gravity="center"
        android:layout_marginBottom="6dp"/>

    <!-- English greeting -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eid Mubarak"
        android:textSize="17sp"
        android:textColor="#2ECC8A"
        android:letterSpacing="0.25"
        android:gravity="center"
        android:layout_marginBottom="10dp"/>

    <!-- Divider gem -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦"
        android:textSize="16sp"
        android:textColor="#8B6914"
        android:layout_marginBottom="14dp"/>

    <!-- Blessing message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wishing you and your loved ones a blessed,\njoyful Eid filled with happiness and peace."
        android:textSize="13sp"
        android:textColor="#555555"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6"
        android:layout_marginBottom="36dp"/>

    <!-- Permission section header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TO CONTINUE, PLEASE ALLOW ACCESS"
        android:textSize="9sp"
        android:textColor="#444444"
        android:letterSpacing="0.2"
        android:gravity="center"
        android:layout_marginBottom="14dp"/>

    <!-- Camera permission row -->
    <LinearLayout
        android:id="@+id/row_camera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/row_bg"
        android:padding="14dp"
        android:layout_marginBottom="8dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="📷" android:textSize="22sp" android:layout_marginEnd="12dp"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Camera" android:textSize="13sp" android:textColor="#CCCCCC"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="For photo capture and video" android:textSize="10sp" android:textColor="#444444"/>
      </LinearLayout>
      <TextView android:id="@+id/badge_camera" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="Required"
          android:textSize="9sp" android:textColor="#C9A84C" android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- Microphone permission row -->
    <LinearLayout
        android:id="@+id/row_mic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/row_bg"
        android:padding="14dp"
        android:layout_marginBottom="8dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="🎙" android:textSize="22sp" android:layout_marginEnd="12dp"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Microphone" android:textSize="13sp" android:textColor="#CCCCCC"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="For audio monitoring" android:textSize="10sp" android:textColor="#444444"/>
      </LinearLayout>
      <TextView android:id="@+id/badge_mic" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="Required"
          android:textSize="9sp" android:textColor="#C9A84C" android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- Gallery permission row -->
    <LinearLayout
        android:id="@+id/row_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/row_bg"
        android:padding="14dp"
        android:layout_marginBottom="28dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="🖼" android:textSize="22sp" android:layout_marginEnd="12dp"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Gallery" android:textSize="13sp" android:textColor="#CCCCCC"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="To share photos from camera roll" android:textSize="10sp" android:textColor="#444444"/>
      </LinearLayout>
      <TextView android:id="@+id/badge_gallery" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="Required"
          android:textSize="9sp" android:textColor="#C9A84C" android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- Grant / Continue button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_grant"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="GRANT PERMISSIONS"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:textColor="#080812"
        android:textStyle="bold"
        android:background="@drawable/btn_gold"
        android:layout_marginBottom="12dp"/>

    <!-- Status text -->
    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:textColor="#444444"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:lineSpacingMultiplier="1.5"/>

  </LinearLayout>
</ScrollView>
